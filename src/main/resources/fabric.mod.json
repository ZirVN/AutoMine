{
	"schemaVersion": 1,
	"id": "automine",
	"version": "${version}",
	"name": "AutoMine",
	"description": "Mark two corners with /sel 1 and /sel 2, then /start: AutoMine clears the whole box top-down in 3-block-tall layers, digging a 3x3 face at a time and steering itself along the best axis.",
	"authors": [
		"you"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/automine/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.automine.AutoMineClient"
		],
		"modmenu": [
			"com.automine.integration.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "automine.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
